<Window x:Class="PdfForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="pdf-forge"
        Width="800"
        Height="450">
    <Grid Margin="24">
        <StackPanel>
            <TextBlock FontSize="28" FontWeight="Bold" Text="pdf-forge" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="14"
                       Text="Windows PDF toolkit scaffold" />
            <TextBlock x:Name="StatusText"
                       Margin="0,20,0,0"
                       FontSize="12"
                       Foreground="DarkSlateGray" />
        </StackPanel>
    </Grid>
</Window>
