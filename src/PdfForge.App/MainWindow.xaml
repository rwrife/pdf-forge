<Window x:Class="PdfForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="pdf-forge"
        Width="1100"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop">
    <DockPanel Margin="12">
        <ToolBar DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button Content="Open PDF" Click="OpenPdfButton_Click" />
            <Button Content="Merge PDFs" Click="MergePdfsButton_Click" Margin="8,0,0,0" />
            <Separator />
            <Button Content="Extract Selected" Click="ExtractSelectedButton_Click" />
            <Button Content="Split (One Per Page)" Click="SplitButton_Click" Margin="8,0,0,0" />
            <Button Content="Compress" Click="CompressButton_Click" Margin="8,0,0,0" />
            <Separator />
            <Button Content="Save As..." Click="SaveAsButton_Click" />
        </ToolBar>

        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Bottom"
                   Margin="0,10,0,0"
                   FontSize="12"
                   Foreground="DarkSlateGray"
                   TextWrapping="Wrap" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Margin="0,0,0,10"
                       FontSize="14"
                       Foreground="DimGray"
                       Text="Drop one or more PDF files here to open/append. Drag cards to reorder pages. Ctrl/Shift-click for multi-select." />

            <ListBox x:Name="PageBoard"
                     Grid.Row="1"
                     BorderThickness="1"
                     BorderBrush="#DDDDDD"
                     Background="#FAFAFA"
                     SelectionMode="Extended"
                     AllowDrop="True"
                     PreviewMouseLeftButtonDown="PageBoard_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="PageBoard_PreviewMouseMove"
                     Drop="PageBoard_Drop"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="8" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="176"
                                Height="282"
                                Padding="6"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="#D0D0D0"
                                Background="White">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" BorderBrush="#E2E2E2" BorderThickness="1" Background="#F3F3F3">
                                    <Image Source="{Binding Thumbnail}"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch" />
                                </Border>

                                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                    <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding DisplayTitle}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Width="72"
                                                Height="24"
                                                Margin="0,0,6,0"
                                                Content="Rotate"
                                                Tag="{Binding}"
                                                Click="RotatePageButton_Click" />
                                        <Button Width="72"
                                                Height="24"
                                                Content="Delete"
                                                Tag="{Binding}"
                                                Click="DeletePageButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
